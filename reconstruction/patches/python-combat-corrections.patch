+    while len(draws) < 4:
+        value = rng.randrange(4)
+        if value not in draws:
+            draws.append(value)
+    item_by_draw = {0: 6, 1: 3, 2: 9, 3: 12}
+    return [item_by_draw[draws[i]] for i in (1, 3, 2, 0)]
